{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/docs/index.html" },
    { "source": "/AGENTS.md", "destination": "/skill.md" },
    { "source": "/((?!src/|docs/|registry/|skill\\.md|README\\.md|LICENSE).*)", "destination": "/docs/$1" }
  ],
  "headers": [
    { "source": "/index.md", "headers": [{ "key": "Link", "value": "<https://uiui.statico.io/>; rel=\"canonical\"" }] },
    { "source": "/(.*)\\.md", "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }] },
    { "source": "/llms(.*)\\.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] }
  ]
}
